LIBRETRO_COMM_DIR  = $(CORE_DIR)/libretro-common

INCFLAGS := \
	-I$(CORE_DIR) \
	-I$(LIBRETRO_COMM_DIR)/include \
	-I$(EMULIB) \
	-I$(LIBZ80) \
	-I$(FMSXDIR)

ifneq (,$(findstring msvc2003,$(platform)))
INCFLAGS += -I$(LIBRETRO_COMM_DIR)/include/compat/msvc
endif

COREDEFINES := -DSKIP_STDIO_REDEFINES

ifeq ($(PATCH_Z80), 1)
COREDEFINES += -DPATCH_Z80
endif

# EMULib sound, console, and other utility functions
SOURCES_C := \
	$(CORE_DIR)/libretro.c \
	$(FMSXDIR)/MSX.c \
	$(FMSXDIR)/V9938.c \
	$(EMULIB)/SHA1.c \
	$(EMULIB)/Floppy.c \
	$(EMULIB)/FDIDisk.c \
	$(EMULIB)/MCF.c \
	$(LIBZ80)/Z80.c \
	$(EMULIB)/I8255.c \
	$(EMULIB)/AY8910.c \
	$(EMULIB)/WD1793.c

ifneq ($(STATIC_LINKING), 1)
SOURCES_C += $(CORE_DIR)/libretro-common/file/retro_dirent.c \
	     $(CORE_DIR)/libretro-common/file/file_path.c \
	     $(CORE_DIR)/libretro-common/file/file_path_io.c \
	     $(CORE_DIR)/libretro-common/compat/compat_posix_string.c \
	     $(CORE_DIR)/libretro-common/compat/compat_strl.c \
	     $(CORE_DIR)/libretro-common/compat/compat_snprintf.c \
	     $(CORE_DIR)/libretro-common/compat/fopen_utf8.c \
	     $(CORE_DIR)/libretro-common/compat/compat_strcasestr.c \
	     $(CORE_DIR)/libretro-common/encodings/encoding_utf.c \
	     $(CORE_DIR)/libretro-common/streams/file_stream.c \
	     $(CORE_DIR)/libretro-common/streams/file_stream_transforms.c \
	     $(CORE_DIR)/libretro-common/time/rtime.c \
	     $(CORE_DIR)/libretro-common/string/stdstring.c \
	     $(CORE_DIR)/libretro-common/vfs/vfs_implementation.c
endif

ifeq ($(PATCH_Z80), 1)
SOURCES_C += $(FMSXDIR)/Patch.c
endif

# Optional MSX Pico external cartridge bus. Disabled in stock fMSX builds.
# All firmware/host sources are taken from a separate local msxpico_sw checkout.
ifeq ($(MSXPICO_FMSX),1)
ifndef MSXPICO_SW_ROOT
$(error MSXPICO_FMSX=1 requires MSXPICO_SW_ROOT=/absolute/path/to/msxpico_sw)
endif
MSXPICO_HOST_ROOT := $(abspath $(MSXPICO_SW_ROOT))
MSXPICO_CORE1_C ?= $(MSXPICO_HOST_ROOT)/build-host/generated/core1_bus_extract.c
COREDEFINES += -DMSXPICO_FMSX=1 -DMSXPICO_HOST_FATFS=1 -DRP2350_COMPILE=1 -DINT_PIN=0
INCFLAGS += -I$(MSXPICO_HOST_ROOT)/simulator/fmsx \
            -I$(MSXPICO_HOST_ROOT)/simulator/host \
            -I$(MSXPICO_HOST_ROOT)/simulator/host/include \
            -I$(MSXPICO_HOST_ROOT)/fatfs/ff15/source \
            -I$(MSXPICO_HOST_ROOT)/fatfs/include \
            -I$(MSXPICO_HOST_ROOT)
SOURCES_C += $(MSXPICO_HOST_ROOT)/simulator/fmsx/msxpico_fmsx_adapter.c \
             $(MSXPICO_HOST_ROOT)/simulator/host/bus_host.c \
             $(MSXPICO_HOST_ROOT)/simulator/host/frame_pacer.c \
             $(MSXPICO_HOST_ROOT)/simulator/host/sd_spi_host.c \
             $(MSXPICO_HOST_ROOT)/simulator/host/fatfs_spi_host.c \
             $(MSXPICO_HOST_ROOT)/fatfs/ff15/source/ff.c \
             $(MSXPICO_HOST_ROOT)/fatfs/ff15/source/ffunicode.c \
             $(MSXPICO_HOST_ROOT)/simulator/host/pico_audio_host.c \
             $(MSXPICO_HOST_ROOT)/simulator/host/wifi_unapi_host.c \
             $(MSXPICO_HOST_ROOT)/emulators/psg/psg.c \
             $(MSXPICO_HOST_ROOT)/emulators/psg/tone_noise.c \
             $(MSXPICO_HOST_ROOT)/emulators/psg/dc_blocker.c \
             $(MSXPICO_HOST_ROOT)/emulators/psg/audio_mixer.c \
             $(MSXPICO_HOST_ROOT)/emulators/psg/hw_tables.c \
             $(MSXPICO_HOST_ROOT)/emu2413.c \
             $(MSXPICO_HOST_ROOT)/emu2212.c \
             $(MSXPICO_CORE1_C)
CFLAGS += -pthread -D_POSIX_C_SOURCE=200809L
LDFLAGS += -pthread -lssl -lcrypto
endif
