# Build native Ubuntu/WSLg SDL2 frontend (no RetroArch).
CC ?= cc
CFLAGS ?= -O2 -Wall -Wextra
SDL_CFLAGS := $(shell sdl2-config --cflags)
SDL_LIBS := $(shell sdl2-config --libs)
.PHONY: all clean
all: fmsx-ubuntu
fmsx-ubuntu: standalone/ubuntu_main.c standalone/mp4_recorder.c standalone/mp4_recorder.h standalone/png_screenshot.c standalone/png_screenshot.h standalone/wav_recorder.c standalone/wav_recorder.h libretro.h
	$(CC) -std=c11 $(CFLAGS) $(SDL_CFLAGS) -I. -o $@ standalone/ubuntu_main.c standalone/mp4_recorder.c standalone/png_screenshot.c standalone/wav_recorder.c $(SDL_LIBS) -ldl -lz
clean:
	rm -f fmsx-ubuntu
